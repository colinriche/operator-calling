# Copy to .env.local for local development.
#
# ─── Firebase ────────────────────────────────────────────────────────────────
#
# The project is always `operator-calling`, hard-coded in lib/firebase-env.ts.
# There is no variable that selects it and no fallback to anywhere else, so the
# browser client and the Admin SDK cannot end up on different projects.
#
# These two are required for anything using the Admin SDK: sign-in verification,
# every /api route, the admin dashboards. The service account MUST belong to
# `operator-calling`.
#
# The key is the `private_key` field of the service-account JSON. Copy what is
# between the quotes - including the surrounding `"` produces
# `error:1E08010C:DECODER routines::unsupported` on the first Firestore call,
# which surfaces as a 403 from every admin route and mentions no key at all.
# Literal \n escapes are normalised, so the one-line form below is fine.

FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@operator-calling.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# ─── Admin login ─────────────────────────────────────────────────────────────
#
# Gates POST /api/admin/token, which mints a custom-token session for an address
# in the `admins` collection. See docs/admin-roles.md.

ADMIN_LOGIN_ENABLED=true

# ─── Other ───────────────────────────────────────────────────────────────────
#
# Salt for visitor-IP hashes. Defaults to FIREBASE_PRIVATE_KEY; set it
# explicitly to keep unique-visit dedupe and rate-limit buckets stable across a
# credential rotation.
# WAITLIST_HASH_SALT=

# Email is off unless BOTH the switch and SMTP credentials are set - see the
# collection-only note in lib/email/send.ts, and docs/email-setup.md.
#
# Amazon SES SMTP. Real values live only in Vercel (Production) - never in a file
# in this repo. SMTP_USER / SMTP_PASS are the SES SMTP credentials, not AWS
# console login or IAM access keys.
# EMAIL_SENDING_ENABLED=true
# SMTP_HOST=email-smtp.<region>.amazonaws.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=The Operator <no-reply@operatorcalling.com>
# Optional: where replies to automated mail go (e.g. a Google Workspace mailbox).
# EMAIL_REPLY_TO=hello@operatorcalling.com

# Contact form email, separate from EMAIL_SENDING_ENABLED above: it does not
# turn on any other mail, and the global switch does not turn this on. It uses
# the same SMTP_* values. Messages are always saved to contactMessages.
# CONTACT_EMAIL_SENDING_ENABLED=true
# CONTACT_EMAIL_TO=
