# Copy to .env.local for local development.
#
# ─── Which Firebase project ──────────────────────────────────────────────────
#
# One variable picks the project for the browser client AND the Admin SDK, so
# the two can never point at different projects.
#
#   prod    operator-calling     (default — used when this is unset)
#   dev     webrtc-clone-dc88c   (the app's dev flavour project)
#   custom  read the NEXT_PUBLIC_FIREBASE_* block below instead
#
# The client config for prod and dev is baked into lib/firebase-env.ts, so
# nothing else needs setting to point the site at either one.

NEXT_PUBLIC_FIREBASE_ENV=prod

# ─── Server credentials ──────────────────────────────────────────────────────
#
# Required for anything using the Admin SDK: sign-in verification, every /api
# route, the admin dashboards. The service account MUST belong to the project
# selected above — a mismatch produces valid sign-ins that fail to verify and
# admin lookups that find nothing.
#
# Set both pairs and they follow NEXT_PUBLIC_FIREBASE_ENV automatically.

FIREBASE_CLIENT_EMAIL_PROD=firebase-adminsdk-xxxxx@operator-calling.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY_PROD="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

FIREBASE_CLIENT_EMAIL_DEV=firebase-adminsdk-xxxxx@webrtc-clone-dc88c.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY_DEV="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Fallback pair, used when the env-scoped one above is not set. Existing
# deployments have only these; they keep working.
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# ─── Custom project (only when NEXT_PUBLIC_FIREBASE_ENV=custom) ──────────────
#
# A third project, or the emulator suite. All six are required together — a
# partial set is rejected rather than merged into a half-configured project.
# Ignored entirely unless the env is `custom`.

# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Other ───────────────────────────────────────────────────────────────────
#
# Salt for visitor-IP hashes. Defaults to the resolved Firebase private key;
# set it explicitly to keep dedupe and rate-limit buckets stable across a
# credential change or a project switch.
# WAITLIST_HASH_SALT=
